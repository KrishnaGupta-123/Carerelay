# Hosted Supabase (required for production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are also supported (use either publishable or anon)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only required by the seed script to create synthetic Auth users
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct connection for CLI migrations/seeding; runtime uses secured RPCs
# Supabase session pooler (port 5432) works on IPv4
DATABASE_URL=
# Public origin; configure Supabase Auth allowed redirect URLs to match
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional emails (use a verified sending domain in production)
RESEND_API_KEY=
EMAIL_FROM=CareRelay <onboarding@resend.dev>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Explicit development-only fallback. Never enabled by default in production.
# With no Supabase URL: real embedded PostgreSQL and password/session authentication.
LOCAL_DEVELOPMENT_MODE=true
LOCAL_DATABASE_PATH=.data/postgres
# Seed script uses this password for ALL fictional accounts. Set before hosted seeding.
DEMO_PASSWORD=

# Optional reminder limits (individual profile preferences remain configurable)
REMINDER_LOOKAHEAD_DAYS=7
NOTIFICATION_BATCH_SIZE=30
